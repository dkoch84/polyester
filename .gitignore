# Dependencies
node_modules/

# Build output
dist/

# Editor extension builds
editors/vscode/*.vsix
editors/vscode/out/
editors/vscode/node_modules/
editors/neovim/.luarocks/

# Generated files in root (use docs/ for publishing)
*.html
*.pdf
!docs/*.html

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Temporary files
tmp/
.cache/

# Packages
*.pkg.tar.zst
pkg/arch/pkg/
pkg/arch/src/

# Personal document examples
examples-private/

# Local Claude Code permissions cache
.claude/settings.local.json
# Generated by editors/vscode/scripts/vendor-polyester.js at package time.
# Committing it means the preview compiler ages independently of the compiler
# it previews: this drifted four months and rendered documents wrong.
editors/vscode/vendor/
