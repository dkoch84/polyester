/grid "420px 1fr" {

  /region --bg #282828 --padding 1.5rem {
    /code polyester {
      /region --bg #1e293b --padding 3rem {

        /text "Content Components" --bold
        --size 1.5rem --color white

        /columns 2 --gap 2rem {

          /frame --bg #334155 --padding 1.5rem {
            /code typescript --lines
            --title "example.ts" {
              const greet = (name: User) =>
              console.log("Hello, " + name);
            }
          }

          /frame --bg #334155 --padding 1.5rem {
            /table --header --striped --dark {
              Feature | HTML | PDF
              Highlighting | Yes | Yes
            }
          }

        }
      }
    }
  }

  /region --bg #1e293b --padding 3rem {

    /text "Content Components" --bold --size 1.5rem --color white

    /region --padding 1rem {
      /text "Rich content primitives for documents." --color #94a3b8
    }

    /columns 2 --gap 2rem {

      /frame --bg #334155 --padding 1.5rem --radius 8px {
        /text "Code Blocks" --bold --color white

        /code typescript --lines --title "example.ts" {
          type User = string;
          const greet = (name: User) =>
          console.log("Hello, " + name);
          greet("World");
        }
      }

      /frame --bg #334155 --padding 1.5rem --radius 8px {
        /text "Tables" --bold --color white

        /table --header --striped --dark {
          Feature | HTML | PDF
          Syntax Highlighting | Yes | Yes
          Line Numbers | Yes | Yes
          Themes | 5+ | 5+
        }
      }

    }

  }

}

/grid "420px 1fr" {

  /region --bg #282828 --padding 1.5rem {
    /code polyester {
      ## Interactive Elements

      /fold "Click to expand" --open {
        /code typescript {
          const compile = (source: string) =>
          generateHTML(parse(source));
        }
      }

      /checkbox "Write docs" --checked
      /checkbox "Add highlighting" --checked
      /checkbox "World domination"
    }
  }

  /region --padding 3rem {

    ## Interactive Elements

    /columns 2 --gap 2rem {

      /region {
        ### Collapsible Sections

        /fold "Click to see implementation details" --open {
          /code typescript {
            const compile = (source: string) =>
            generateHTML(parse(source));
          }

          The compiler parses your `.poly` file into an AST,
          then renders to your target format.
        }

        /fold "Advanced configuration" {
          Configuration options for power users.
          Theme customization, output formats, and more.
        }
      }

      /region {
        ### Task Lists

        /checkbox "Write documentation" --checked
        /checkbox "Add syntax highlighting" --checked
        /checkbox "Create VSCode extension" --checked
        /checkbox "Build Neovim plugin" --checked
        /checkbox "World domination"

        /region --padding 1rem {
          Progress: 4/5 complete
        }
      }

    }

  }

}

/grid "420px 1fr" {

  /region --bg #282828 --padding 1.5rem {
    /code polyester {
      /region --bg #fef3c7 --padding 3rem {

        ## Design System

        /page A4 --style playful --spacing compact

        /columns 4 --gap 1rem {
          /frame --bg #1e40af --padding 1rem {
            /text "Corporate" --color white
          }
          /frame --bg #18181b --padding 1rem {
            /text "Minimal" --color white
          }
          /frame --bg #8b5cf6 --padding 1rem {
            /text "Playful" --color white
          }
          /frame --bg #0f172a --padding 1rem {
            /text "Dark" --color #60a5fa
          }
        }

      }
    }
  }

  /region --bg #fef3c7 --padding 3rem {

    ## Design System

    Three composable modules—**style**, **spacing**, and **syntax**—that mix independently.

    /columns 4 --gap 1rem {
      /frame --bg #1e40af --padding 1rem --radius 8px {
        /text "Corporate" --color white --size 0.9rem
      }
      /frame --bg #18181b --padding 1rem --radius 8px {
        /text "Minimal" --color white --size 0.9rem
      }
      /frame --bg #8b5cf6 --padding 1rem --radius 8px {
        /text "Playful" --color white --size 0.9rem
      }
      /frame --bg #0f172a --padding 1rem --radius 8px {
        /text "Dark" --color #60a5fa --size 0.9rem
      }
    }

    /code bash {
      # Apply style + spacing presets
      poly build doc.poly --style corporate --spacing compact

      # Import terminal colorschemes
      poly theme import ~/.Xresources --name my-theme
      poly build doc.poly --theme my-theme
    }

    /region --padding 0.5rem {
      /text "Learn more:" --size 0.85rem --color #64748b

      /inline --gap 1rem {
        /button secondary "Design Tokens" --href "design-system.html"
        /button secondary "Theme Studio" --href "theme-studio.html"
      }
    }

  }

}

/grid "420px 1fr" {

  /region --bg #282828 --padding 1.5rem {
    /code polyester {
      /region --padding 3rem {

        ## Pagination

        /page --pageless

        Content flows continuously...

        /pagebreak

        New section starts here.

      }
    }
  }

  /region --padding 3rem {

    ## Pagination

    Control how PDFs are paginated. Use `--pageless` for continuous scrolling, or `/pagebreak` for explicit control.

    /columns 2 --gap 2rem {

      /frame --bg #f0f9ff --padding 1.5rem --radius 8px {
        /text "Continuous" --bold --size 0.9rem
        /code polyester {
          /page --pageless
        }
        One long page. Tables and figures stay intact.
      }

      /frame --bg #f0fdf4 --padding 1.5rem --radius 8px {
        /text "Explicit Breaks" --bold --size 0.9rem
        /code polyester {
          /pagebreak
        }
        Force a new page at any point.
      }

    }

  }

}

