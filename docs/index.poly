/page A4 --margin 0 --max-width none

/style {
  body {
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }
  .poly-grid {
    align-items: stretch;
  }
  .poly-grid > .poly-region:first-child {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.5rem 0.75rem !important;
  }
  .poly-grid > .poly-region:first-child .poly-code-block {
    margin: 0;
  }
  .poly-grid > .poly-region:first-child .poly-code-block pre {
    background: transparent !important;
    margin: 0;
    padding: 0;
  }
  .poly-grid > .poly-region:first-child .poly-code-block code {
    color: #ebdbb2;
  }

  /* Responsive: hide code sidebar on smaller screens */
  @media (max-width: 900px) {
    .poly-grid {
      grid-template-columns: 1fr !important;
    }
    .poly-grid > .poly-region:first-child {
      display: none !important;
    }
  }

  /* Responsive: stack columns on mobile */
  @media (max-width: 768px) {
    .poly-columns {
      flex-direction: column !important;
    }
    .poly-columns > * {
      flex: 1 1 100% !important;
      max-width: 100% !important;
    }
  }

  /* Responsive: reduce 4-column grids on tablet */
  @media (max-width: 900px) {
    .poly-columns[style*="--poly-columns: 4"] {
      --poly-columns: 2 !important;
    }
  }

  /* Responsive: reduce 3-column grids on smaller screens */
  @media (max-width: 768px) {
    .poly-columns[style*="--poly-columns: 3"],
    .poly-columns[style*="--poly-columns: 4"] {
      --poly-columns: 1 !important;
    }
  }
}

/grid "420px 1fr" {

  /region --bg #282828 --padding 1.5rem {
    /code polyester {
      /hero --bg gradient {
        /vcenter --height 90vh {
          /text "Polyester" --bold --size 4rem 
            --color white --tracking wide

          /region --padding 1rem {
            A document language that feels like home.

            Markdown simplicity meets programming power.
          }

          /button primary "Get Started"
          /button secondary "View on GitHub"
        }
      }
    }
  }

  /hero --bg gradient {
    /vcenter --height 90vh {
      /text "Polyester" --bold --size 4rem --color white --tracking wide

      /region --padding 1rem {
        A document language that feels like home.

        Markdown simplicity meets programming power.
      }

      /region --padding 2rem {
        /button primary "Get Started" --href "https://github.com/dkoch84/polyester/releases"
        /button secondary "View on GitHub" --href "https://github.com/dkoch84/polyester"
      }
    }
  }

}

