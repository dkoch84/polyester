{
  "name": "btn-stripe",
  "category": "buttons",
  "description": "Stripe-inspired indigo gradient button.",
  "targets": ["button"],
  "wrapperClass": "btn-stripe",
  "sampleMarkup": "/region --class btn-stripe { /button \"Subscribe\" }",
  "css": ".btn-stripe .poly-button {\n  background: linear-gradient(180deg, #635bff, #5851e8);\n  color: #fff;\n  border: none;\n  border-radius: 6px;\n  padding: 0.6rem 1.1rem;\n  font-weight: 600;\n  font-family: \"Inter\", system-ui, sans-serif;\n  box-shadow: 0 1px 2px rgba(50,50,93,0.1), 0 1px 1px rgba(0,0,0,0.07);\n}"
}
